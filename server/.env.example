# ====== MARTHINGTON IQ - ENVIRONMENT CONFIGURATION ======

# ========== DATABASE ==========
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/marthington-db

# ========== API KEYS ==========
# Google Gemini API Key (for AI question generation)
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ========== JWT & SECURITY ==========
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# ========== EMAIL (Nodemailer) ==========
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@marthington.com

# ========== PAYMENT (Flutterwave) ==========
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_SUBACCOUNT_ID=your-subaccount-id

# ========== SERVER ==========
PORT=5000
NODE_ENV=development

# ========== FRONTEND ==========
FRONTEND_URL=http://localhost:5173

# ========== CORS ==========
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# ========== OPTIONAL: AI SETTINGS ==========
# Maximum questions to generate in one request
AI_MAX_QUESTIONS=20

# Cache questions for this many days before cleanup (default: 30)
AI_CACHE_RETENTION_DAYS=30

# Pre-generate common topics on startup (true/false)
AI_PRE_GENERATE_ON_STARTUP=true
